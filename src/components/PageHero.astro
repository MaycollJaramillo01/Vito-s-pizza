---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: string;
}

const { eyebrow, title, lead, image = '/media/hero.jpg' } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-media" aria-hidden="true">
    <img src={image} alt="" width="1920" height="900" />
  </div>
  <div class="page-hero-rule" aria-hidden="true"></div>
  <div class="container reveal">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
