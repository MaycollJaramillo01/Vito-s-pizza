---
import { site, chefBio } from '../../data/site';
---

<section class="section chef-section">
  <p class="section-watermark" aria-hidden="true">Shop</p>
  <div class="container split reveal">
    <div class="split-media">
      <span class="split-frame" aria-hidden="true"></span>
      <img src={chefBio.image} alt="Inside a neighborhood pizza shop" width="800" height="1000" loading="lazy" />
    </div>
    <div class="split-copy">
      <span class="split-quote" aria-hidden="true">“</span>
      <p class="eyebrow">Our Story</p>
      <h2>{chefBio.title}</h2>
      {chefBio.paragraphs.map((p) => <p class="prose stack-sm">{p}</p>)}
      <div class="hero-actions stack-lg">
        <a class="btn" href="/menu/">See Our Menu</a>
        <a class="btn btn-ghost" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
      </div>
    </div>
  </div>
</section>
