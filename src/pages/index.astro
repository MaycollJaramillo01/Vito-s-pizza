---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import QuickActions from '../components/home/QuickActions.astro';
import FeaturedDishes from '../components/home/FeaturedDishes.astro';
import MenuCategories from '../components/home/MenuCategories.astro';
import WhyChoose from '../components/home/WhyChoose.astro';
import Reviews from '../components/home/Reviews.astro';
import CateringTeaser from '../components/home/CateringTeaser.astro';
import Chef from '../components/home/Chef.astro';
import Gallery from '../components/home/Gallery.astro';
import Location from '../components/home/Location.astro';
import OrderCta from '../components/home/OrderCta.astro';
import Faqs from '../components/home/Faqs.astro';
import { site } from '../data/site';
---

<SiteLayout
  title={`Vito’s Pizza | Pizza & Italian Food in Mechanicsburg, PA`}
  description={site.description}
  current="/"
>
  <Hero />
  <QuickActions />
  <FeaturedDishes />
  <MenuCategories />
  <WhyChoose />
  <Reviews />
  <CateringTeaser />
  <Chef />
  <Gallery />
  <Location />
  <OrderCta />
  <Faqs />
</SiteLayout>
