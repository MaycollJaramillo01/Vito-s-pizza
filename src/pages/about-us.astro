---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import DishList from '../components/DishList.astro';
import { site, aboutCopy, dishes } from '../data/site';
---

<SiteLayout
  title={`About Us – ${site.name}`}
  description="Vito’s Pizza is a neighborhood shop at 265 Cumberland Pkwy in Mechanicsburg, PA — pizza, subs, wings, pasta, pickup and delivery."
  current="/about-us/"
>
  <PageHero
    eyebrow="About Vito’s"
    title='Mechanicsburg’s neighborhood <span class="accent">pizza shop.</span>'
    image="/media/story.jpg"
  />

  <section class="section about-story">
    <div class="container about-story-grid reveal">
      <div class="about-story-copy">
        <p class="eyebrow">Our story</p>
        <div class="about-story-text">
          {aboutCopy.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="hero-actions stack-lg">
          <a class="btn" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
          <a class="btn btn-ghost" href="/contact-us/">Visit / Hours</a>
        </div>
      </div>

      <ul class="about-pillars">
        {
          aboutCopy.pillars.map((item, i) => (
            <li>
              <span class="about-pillar-num">{String(i + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-tight-top">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Signatures</p>
        <h2>What people order first</h2>
      </div>
      <div class="reveal">
        <DishList dishes={dishes} />
      </div>
    </div>
  </section>
</SiteLayout>
